{
    "name": "n8n-nodes-polycracker",
    "version": "1.1.0",
    "description": "Premium AI orchestration nodes for n8n",
    "author": {
        "name": "Parrot Integrated Software",
        "email": "parrotsoftwarebc@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/parrot-software-bc/n8n-nodes-polycracker.git"
    },
    "homepage": "https://github.com/parrot-software-bc/n8n-nodes-polycracker#readme",
    "keywords": ["n8n-community-node-package"],
    "license": "MIT",
    "main": "index.js",
    "files": ["dist"],
    "scripts": {
        "build": "tsc && node scripts/copy-assets.js",
        "dev": "tsc --watch",
        "lint": "eslint nodes/**/*.ts credentials/**/*.ts",
        "prepublishOnly": "npm run build"
    },
    "n8n": {
        "n8nNodesApiVersion": 1,
        "credentials": [
            "dist/credentials/ParrotApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/ParrotGate/ParrotGate.node.js"
        ]
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    },
    "devDependencies": {
        "@n8n/eslint-plugin-community-nodes": "^0.26.0",
        "eslint": "9.29.0",
        "n8n-core": "latest",
        "n8n-workflow": "latest",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.0.0"
    }
}
